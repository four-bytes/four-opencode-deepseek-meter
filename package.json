{
  "name": "@four-bytes/four-opencode-deepseek-meter",
  "version": "0.1.0",
  "description": "opencode Plugin: shows DeepSeek API balance in the TUI sidebar",
  "license": "Apache-2.0",
  "type": "module",
  "main": "dist/four-opencode-deepseek-meter.js",
  "scripts": {
    "build": "NODE_ENV=production bun build src/four-opencode-deepseek-meter.ts --outdir=dist --target=bun --external \"@opencode-ai/*\"",
    "build:tui": "NODE_ENV=production bun build src/tui.tsx --outfile=dist/four-opencode-deepseek-meter-tui.jsx --target=bun --external \"@opencode-ai/*\" --external \"@opentui/*\" --external \"solid-js\"",
    "typecheck": "bunx tsc --noEmit",
    "test": "bun test"
  },
  "keywords": [
    "opencode",
    "opencode-plugin",
    "four-bytes",
    "deepseek",
    "balance"
  ],
  "exports": {
    ".": {
      "import": "./dist/four-opencode-deepseek-meter.js"
    },
    "./server": {
      "import": "./dist/four-opencode-deepseek-meter.js",
      "config": {
        "enabled": true
      }
    },
    "./tui": {
      "import": "./dist/four-opencode-deepseek-meter-tui.jsx",
      "config": {
        "enabled": true,
        "sidebar": true
      }
    }
  },
  "dependencies": {
    "@opencode-ai/plugin": "1.16.2",
    "@opentui/core": "0.3.2",
    "@opentui/solid": "0.3.2",
    "solid-js": "1.9.13"
  },
  "devDependencies": {
    "@types/bun": "^1.3.8",
    "typescript": "^5.7.3"
  }
}
