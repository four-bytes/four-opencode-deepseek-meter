{
  "name": "@four-bytes/four-opencode-deepseek-meter",
  "version": "0.1.0",
  "description": "opencode Plugin: shows DeepSeek API balance in the TUI sidebar",
  "license": "Apache-2.0",
  "type": "module",
  "main": "dist/four-opencode-deepseek-meter.js",
  "scripts": {
    "build": "NODE_ENV=production bun run scripts/build.ts",
    "dev": "bun run scripts/build.ts",
    "typecheck": "bunx tsc --noEmit",
    "test": "bun test"
  },
  "keywords": [
    "opencode",
    "opencode-plugin",
    "four-bytes",
    "deepseek",
    "balance"
  ],
  "exports": {
    "./server": {
      "import": "./dist/four-opencode-deepseek-meter.js",
      "config": {
        "enabled": true
      }
    },
    "./tui": {
      "import": "./dist/tui.tsx",
      "config": {
        "enabled": true,
        "sidebar": true
      }
    }
  },
  "dependencies": {
    "@opencode-ai/plugin": "^1.4.3",
    "@opentui/solid": "^0.2.2",
    "solid-js": "^1.9.12"
  },
  "devDependencies": {
    "@types/bun": "^1.3.8",
    "typescript": "^5.7.3"
  }
}
